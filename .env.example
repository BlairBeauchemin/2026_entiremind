# Copy to .env.local and fill in real values.
# Vercel: set the same variables in the dashboard (Production + Preview).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Tag Manager — all marketing pixels (GA4, Google Ads, Meta, TikTok)
# are configured inside this container. See docs/marketing/gtm-setup.md.
# Leave unset in local dev to disable tracking entirely.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Landing page A/B
NEXT_PUBLIC_WAITLIST_MODAL_VERSION=single

# SMS (Twilio - default provider)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx

# Cron
CRON_SECRET=your-cron-secret

# AI (anthropic default, or openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx

# Admin
ADMIN_EMAIL=you@example.com
