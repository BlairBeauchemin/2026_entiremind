# Copy to .env.local and fill in real values.
# Vercel: set the same variables in the dashboard (Production + Preview).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Tag Manager — all marketing pixels (GA4, Google Ads, Meta, TikTok)
# are configured inside this container. See docs/marketing/gtm-setup.md.
# Leave unset in local dev to disable tracking entirely.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Landing page A/B
NEXT_PUBLIC_WAITLIST_MODAL_VERSION=single

# SMS (Twilio - default provider)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx

# Cron
CRON_SECRET=your-cron-secret

# AI (anthropic default, or openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx

# Admin
ADMIN_EMAIL=you@example.com

# Health alerting (see .github/workflows/health-check.yml)
# Email, not SMS, on purpose: the thing most likely to be broken is the SMS
# path, and an alert that travels down the failing wire is no alert.
# Without RESEND_API_KEY the checks still run and the GitHub Actions job still
# fails loudly — you just lose the detailed email.
RESEND_API_KEY=re_xxx
ALERT_EMAIL_TO=you@example.com          # optional, defaults to ADMIN_EMAIL
ALERT_EMAIL_FROM=alerts@entiremind.com  # must be a domain verified in Resend
ALERT_THROTTLE_HOURS=12                 # optional, one email per condition per N hours
TWILIO_BALANCE_WARN_USD=10              # optional, warn below this; critical below half
